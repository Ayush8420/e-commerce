# ==============================================================================
# 1. PostgreSQL (Aiven for PostgreSQL or Local Docker)
# ==============================================================================
# For Aiven: "postgres://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require"
# For Local Docker: "postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ==============================================================================
# 2. Apache Kafka (Aiven for Apache Kafka or Local Docker)
# ==============================================================================
# For Local Docker:
#   KAFKA_BROKERS="localhost:9092"
#   KAFKA_SSL=false
#
# For Aiven (SASL/SCRAM):
#   KAFKA_BROKERS="<host>:<port>"
#   KAFKA_SSL=true
#   KAFKA_SASL_MECHANISM="scram-sha-256" # or scram-sha-512 or plain
#   KAFKA_USERNAME="avnadmin"
#   KAFKA_PASSWORD="<password>"
#   KAFKA_CA_PATH="./certs/ca.pem" # or inline PEM via KAFKA_CA_CERT
#
# For Aiven (Client Certificate / mTLS):
#   KAFKA_BROKERS="<host>:<port>"
#   KAFKA_SSL=true
#   KAFKA_CA_PATH="./certs/ca.pem"
#   KAFKA_CLIENT_CERT_PATH="./certs/service.cert"
#   KAFKA_CLIENT_KEY_PATH="./certs/service.key"
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="ecommerce-api"
KAFKA_GROUP_PREFIX="ecommerce"
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=""
KAFKA_USERNAME=""
KAFKA_PASSWORD=""
KAFKA_CA_PATH=""
KAFKA_CA_CERT=""
KAFKA_CLIENT_CERT_PATH=""
KAFKA_CLIENT_KEY_PATH=""
KAFKA_SSL_REJECT_UNAUTHORIZED=true
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ==============================================================================
# 3. OpenSearch (Aiven for OpenSearch or Local Docker)
# ==============================================================================
# For Local Docker:
#   OPENSEARCH_NODE="http://localhost:9200"
#   OPENSEARCH_USERNAME=""
#   OPENSEARCH_PASSWORD=""
#
# For Aiven:
#   OPENSEARCH_NODE="https://<host>:<port>"
#   OPENSEARCH_USERNAME="avnadmin"
#   OPENSEARCH_PASSWORD="<password>"
#   OPENSEARCH_REJECT_UNAUTHORIZED=true
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_PRODUCTS_INDEX="products_v1"
OPENSEARCH_CA_PATH=""
OPENSEARCH_CA_CERT=""
OPENSEARCH_REJECT_UNAUTHORIZED=true

# Email / SMTP (Gmail via Nodemailer + 16-char Google App Password)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Payments (UPI primary + optional Razorpay/Stripe)
UPI_PROVIDER="mock"
MERCHANT_UPI_VPA="aethermart@upi"
MERCHANT_UPI_NAME="AetherMart Commerce"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# API CORS allowlist (comma-separated when multiple frontend origins are used)
FRONTEND_URL="http://localhost:3000"

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_NAME="AetherMart"

