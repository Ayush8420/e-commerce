# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# API Server
API_PORT=4000
FRONTEND_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"

# JWT Auth
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Google OAuth 2.0 (Optional: configure from Google Cloud Console)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# OpenSearch
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_PRODUCTS_INDEX="products_v1"

# Kafka
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="ecommerce-api"
KAFKA_GROUP_PREFIX="ecommerce"
# Optional SASL/SSL for managed cloud Kafka (Redpanda Serverless, Confluent, Upstash, Aiven)
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=""
KAFKA_USERNAME=""
KAFKA_PASSWORD=""

# Email / SMTP (Gmail via Nodemailer + 16-char Google App Password)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Payments (UPI primary + optional Razorpay/Stripe)
UPI_PROVIDER="mock"
MERCHANT_UPI_VPA="aethermart@upi"
MERCHANT_UPI_NAME="AetherMart Commerce"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_NAME="AetherMart"

