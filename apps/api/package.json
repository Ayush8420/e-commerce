{
  "name": "@ecommerce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "prisma:generate": "node scripts/prisma-env.cjs generate",
    "prisma:migrate": "node scripts/prisma-env.cjs migrate dev",
    "prisma:push": "node scripts/prisma-env.cjs db push",
    "prisma:seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@ecommerce/shared": "*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@opensearch-project/opensearch": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.19.3",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
}
